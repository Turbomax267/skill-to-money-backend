APP_NAME="Skill To Money API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-lovable-app.lovable.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
API_TOKEN_TTL_DAYS=30
PERU_API_BASE_URL=https://peruapi.com
PERU_API_KEY=
PERU_API_TIMEOUT=8
PERU_API_FALLBACK_URL=https://skill-to-money-backend.onrender.com/api/peru
GEMINI_API_KEY=
GEMINI_API_TIMEOUT=20
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_API_TIMEOUT=20
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=SkillToMoney
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_TIMEOUT=20
AI_LOCAL_FALLBACK_ENABLED=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=your-render-postgres-host
DB_PORT=5432
DB_DATABASE=your-render-postgres-database
DB_USERNAME=your-render-postgres-user
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
FILESYSTEM_DISK=local
PUBLIC_DISK_ROOT=
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
GOOGLE_MAIL_WEBHOOK_URL=
GOOGLE_MAIL_WEBHOOK_SECRET=
GOOGLE_MAIL_WEBHOOK_TIMEOUT=15

VITE_APP_NAME="${APP_NAME}"
